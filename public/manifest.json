{
  "manifest_version": 3,
  "name": "Suno Lyrics Exporter",
  "version": "0.1.0",
  "description": "Preview, check, copy, and download timed lyrics from Suno song pages.",
  "permissions": ["storage", "activeTab", "downloads"],
  "host_permissions": [
    "https://suno.com/*",
    "https://studio-api.prod.suno.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Suno Lyrics Exporter",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
